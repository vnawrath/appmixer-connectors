{
    "name": "appmixer.telegram.messages.SendMessageWithKeyboard",
    "label": "Send Message with Keyboard",
    "author": "Appmixer <info@appmixer.com>",
    "icon": "data:image/svg+xml;base64,",
    "description": "Send a text message to a Telegram chat with inline keyboard buttons.",
    "private": false,
    "auth": {
        "service": "appmixer:telegram"
    },
    "inPorts": [
        {
            "name": "in",
            "schema": {
                "type": "object",
                "properties": {
                    "chatId": { 
                        "type": "string",
                        "description": "Chat ID to send the message to"
                    },
                    "text": { 
                        "type": "string",
                        "description": "Message text to send"
                    },
                    "parseMode": {
                        "type": "string",
                        "enum": ["", "HTML", "Markdown", "MarkdownV2"],
                        "description": "Text formatting mode"
                    },
                    "buttons": {
                        "type": "array",
                        "description": "Array of button rows for inline keyboard",
                        "items": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "text": {
                                        "type": "string",
                                        "description": "Button label"
                                    },
                                    "callback_data": {
                                        "type": "string",
                                        "description": "Data to be sent in callback query"
                                    },
                                    "url": {
                                        "type": "string",
                                        "description": "HTTP or telegram:// URL to open"
                                    }
                                },
                                "required": ["text"]
                            }
                        }
                    },
                    "disableWebPagePreview": {
                        "type": "boolean",
                        "description": "Disable link previews for links in the message"
                    },
                    "disableNotification": {
                        "type": "boolean",
                        "description": "Send message silently"
                    }
                },
                "required": ["chatId", "text", "buttons"]
            },
            "inspector": {
                "inputs": {
                    "chatId": {
                        "type": "text",
                        "label": "Chat ID",
                        "tooltip": "The chat ID where to send the message. Can be a user ID, group chat ID, or channel username.",
                        "index": 1
                    },
                    "text": {
                        "type": "textarea",
                        "label": "Message Text",
                        "tooltip": "The text message to send. Maximum 4096 characters.",
                        "index": 2
                    },
                    "parseMode": {
                        "type": "select",
                        "label": "Text Formatting",
                        "tooltip": "Choose how to format the text in the message.",
                        "index": 3,
                        "defaultValue": "",
                        "options": [
                            { "label": "None", "value": "" },
                            { "label": "HTML", "value": "HTML" },
                            { "label": "Markdown", "value": "Markdown" },
                            { "label": "MarkdownV2", "value": "MarkdownV2" }
                        ]
                    },
                    "buttons": {
                        "type": "textarea",
                        "label": "Keyboard Buttons (JSON)",
                        "tooltip": "JSON array of button rows. Each row is an array of button objects with 'text' and optionally 'callback_data' or 'url'.",
                        "index": 4,
                        "defaultValue": "[[{\"text\": \"Button 1\", \"callback_data\": \"btn1\"}, {\"text\": \"Button 2\", \"callback_data\": \"btn2\"}]]"
                    },
                    "disableWebPagePreview": {
                        "type": "toggle",
                        "label": "Disable Link Previews",
                        "tooltip": "Disable automatic web page previews for links in the message.",
                        "index": 5,
                        "defaultValue": false
                    },
                    "disableNotification": {
                        "type": "toggle",
                        "label": "Silent Message",
                        "tooltip": "Send the message silently without notifying users.",
                        "index": 6,
                        "defaultValue": false
                    }
                }
            }
        }
    ],
    "outPorts": [
        {
            "name": "out",
            "options": [
                { "label": "Message ID", "value": "message_id", "schema": { "type": "number" } },
                { "label": "Date", "value": "date", "schema": { "type": "number" } },
                { "label": "Text", "value": "text", "schema": { "type": "string" } },
                { "label": "Chat ID", "value": "chat.id", "schema": { "type": "number" } },
                { "label": "Chat Type", "value": "chat.type", "schema": { "type": "string" } },
                { "label": "Chat Title", "value": "chat.title", "schema": { "type": "string" } },
                { "label": "From Bot ID", "value": "from.id", "schema": { "type": "number" } },
                { "label": "From Bot Username", "value": "from.username", "schema": { "type": "string" } },
                { "label": "From Bot First Name", "value": "from.first_name", "schema": { "type": "string" } },
                { "label": "Reply Markup", "value": "reply_markup", "schema": { "type": "object" } }
            ]
        }
    ]
}